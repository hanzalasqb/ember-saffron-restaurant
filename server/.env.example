PORT=4100
# Restaurant local time zone (reservation slots use it)
TZ=Asia/Karachi
# Empty = embedded PGlite in ./data; docker-compose uses PostgreSQL
DATABASE_URL=
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# Manager account created on first start (random password printed once if empty)
ADMIN_EMAIL=manager@ember-saffron.local
ADMIN_PASSWORD=
# Optional OpenAI-compatible LLM for the concierge and menu insights (rule-based fallback without it)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
CORS_ORIGIN=http://localhost:5173
